# ── Database ─────────────────────────────────────────────────────────────────
# For LOCAL / DigitalOcean Docker deployment:
POSTGRES_USER=ananta
POSTGRES_PASSWORD=change_this_strong_password
POSTGRES_DB=shopdb

# For Render + Supabase (free tier):
# Set this directly in Render dashboard → Environment Variables
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# ── AI APIs ───────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-proj-...

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=7123456789:AAF...
SHOP_CHAT_ID=123456789          # your personal Telegram numeric ID

# ── App settings ──────────────────────────────────────────────────────────────
TIMEZONE=Asia/Kolkata
IMAGES_DIR=/tmp/ananta_images   # use /app/images for DigitalOcean persistent volume
SHOP_NAME=Sharma Electricals

# ── Backend public URL (required for Telegram webhook) ────────────────────────
# Set to your Render service URL after first deploy, e.g.:
APP_BASE_URL=https://ananta-backend.onrender.com

# ── Cloudflare R2 (optional — falls back to local disk if not set) ────────────
# Sign up at dash.cloudflare.com → R2 → Create bucket
# Account ID: top-right of Cloudflare dashboard
R2_ACCOUNT_ID=abc123def456...
# API Token: R2 → Manage R2 API tokens → Create token (Object Read & Write)
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET_NAME=ananta-images
# Public URL: R2 bucket → Settings → Public Access → Enable → copy URL
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxx.r2.dev

# ── Docker-only (built automatically from POSTGRES_* above) ───────────────────
# DATABASE_URL=postgresql+asyncpg://ananta:password@db:5432/shopdb
